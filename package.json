{
  "name": "grambot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that bridges a Telegram bot to Grok Bot routines and exposes a send-only MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcen/grambot.git"
  },
  "homepage": "https://github.com/0xcen/grambot#readme",
  "bugs": {
    "url": "https://github.com/0xcen/grambot/issues"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "grok-bot",
    "cloudflare-workers",
    "mcp",
    "model-context-protocol",
    "webhook"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint:sh": "shellcheck scripts/setup.sh",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.5",
    "shellcheck": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
